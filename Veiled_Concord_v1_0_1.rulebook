  "publisher": "Homebrew",
  "url": "https://raw.githubusercontent.com/omega1968/Veiled-Concord-40k/main/Veiled_Concord_v1_0_1.rulebook",
  "notes": "Custom homebrew faction for private playtesting. Stage 2 adds the 12-detachment DP system, 48 Enhancements, 72 Stratagems, detachment selection, and validation scaffolding on top of the Stage 1 datasheets.",
  "wip": true,
